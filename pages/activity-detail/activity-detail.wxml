<!-- pages/activity-detail/activity-detail.wxml -->
<view class="container" wx:if="{{!loading && activity}}">
  <!-- 活动标题 -->
  <view class="title-section">
    <text class="title">{{activity.title}}</text>
    <view class="type-tag">{{activity.typeName || activity.type}}</view>
  </view>

  <!-- 活动信息卡片 -->
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">⏰ 活动时间</text>
      <text class="info-value">{{activity.startTime}} - {{activity.endTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">📍 活动地点</text>
      <text class="info-value">{{activity.location || '待定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">👥 参与人数</text>
      <text class="info-value">{{activity.currentParticipants || 0}} / {{activity.maxParticipants || '不限'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">📅 报名截止</text>
      <text class="info-value">{{activity.deadline || '无'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">🏷️ 活动状态</text>
      <text class="info-value status {{activity.status}}">{{activity.statusText}}</text>
    </view>
  </view>

  <!-- 活动简介 -->
  <view class="desc-section" wx:if="{{activity.description}}">
    <text class="section-title">活动简介</text>
    <text class="desc-content">{{activity.description}}</text>
  </view>

  <!-- 活动详情 -->
  <view class="detail-section" wx:if="{{activity.detail}}">
    <text class="section-title">活动详情</text>
    <text class="detail-content">{{activity.detail}}</text>
  </view>

  <!-- 主办方信息 -->
  <view class="org-section" wx:if="{{activity.organizer}}">
    <text class="section-title">主办方</text>
    <text class="org-name">{{activity.organizer}}</text>
  </view>

  <!-- 底部按钮 -->
<!-- 底部按钮 -->
<view class="bottom-buttons">
  <button class="favorite-btn" bindtap="toggleFavorite">
    {{isFavorite ? '❤️ 已收藏' : '🤍 收藏'}}
  </button>
  <button class="register-btn" wx:if="{{!isRegistered && activity.status === 'upcoming'}}" bindtap="registerActivity">立即报名</button>
  <button class="cancel-btn" wx:if="{{isRegistered && activity.status === 'upcoming'}}" bindtap="cancelRegister">取消报名</button>
  <button class="disabled-btn" wx:if="{{!isRegistered && activity.status !== 'upcoming'}}" disabled>{{activity.status === 'ongoing' ? '进行中，无法报名' : '活动已结束'}}</button>
</view>
</view>

<!-- 加载状态 -->
<view class="loading-state" wx:if="{{loading}}">
  <text>加载中...</text>
</view>