.discover-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 48rpx;
  margin-bottom: 20rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  background-color: #4CAF50;
  color: #fff;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.classroom-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.classroom-name {
  font-size: 32rpx;
  font-weight: bold;
}

.classroom-info {
  display: flex;
  gap: 24rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
  color: #666;
}

.btn-add-todo {
  background-color: #f5f5f5;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 48rpx;
  margin-top: 12rpx;
}

.activity-search {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background-color: #fff;
  border-radius: 48rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.type-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.type-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #fff;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: #666;
}

.type-item.active {
  background-color: #4CAF50;
  color: #fff;
}

.activity-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.activity-cover-placeholder {
  width: 160rpx;
  height: 160rpx;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}

.activity-content {
  flex: 1;
  padding: 20rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.activity-time, .activity-location {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status.upcoming {
  background-color: #e3f2fd;
  color: #2196F3;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}