/* pages/discover/discover.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* Tab切换 */
.tabs {
  display: flex;
  background-color: white;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #007aff;
  border-radius: 2rpx;
}

/* 筛选行 */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  padding: 20rpx 30rpx;
  background-color: white;
  border-bottom: 1rpx solid #e8e8e8;
}

.filter-chip {
  padding: 15rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #333;
}

.filter-chip.advanced {
  background-color: #e8f4ff;
  color: #007aff;
}

/* 高级筛选面板 */
.advanced-panel {
  background-color: white;
  padding: 30rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.advanced-row {
  margin-bottom: 30rpx;
}

.advanced-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.advanced-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.advanced-option {
  padding: 15rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
}

.advanced-option.active {
  background-color: #007aff;
  color: white;
}

.advanced-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.reset-btn, .confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.reset-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #007aff;
  color: white;
}

/* 滑动日期选择器 */
.date-scroll {
  background-color: white;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.date-list {
  white-space: nowrap;
  padding: 0 20rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 110rpx;
  padding: 20rpx 0;
  margin-right: 10rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
}

.date-item.active {
  background-color: #007aff;
  color: white;
}

.date-weekday {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.date-day {
  font-size: 34rpx;
  font-weight: bold;
}

/* 时间段选择 */
.time-row {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  padding: 20rpx 30rpx;
  background-color: white;
  border-bottom: 1rpx solid #e8e8e8;
}

.time-chip {
  padding: 12rpx 25rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
}

.time-chip.active {
  background-color: #007aff;
  color: white;
}

/* 教室网格 */
.classroom-list {
  flex: 1;
  padding: 20rpx;
  height: calc(100vh - 500rpx);
}

.classroom-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.classroom-card {
  width: calc(33.33% - 14rpx);
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.classroom-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.classroom-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.classroom-info text {
  margin: 0 5rpx;
}

.classroom-status {
  font-size: 24rpx;
  padding: 6rpx 15rpx;
  border-radius: 30rpx;
  display: inline-block;
}

.status-free {
  background-color: #e8f5e9;
  color: #4caf50;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 20rpx;
  background-color: #f5f7fa;
  font-size: 22rpx;
  color: #999;
}

.footer-tip text {
  display: block;
  margin-bottom: 8rpx;
}

/* 加载和空状态 */
.loading-state, .empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state .tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 活动样式 */
.activity-filter {
  background-color: white;
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.search-input {
  background-color: #f5f5f5;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.type-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.type-tab {
  display: inline-block;
  padding: 15rpx 30rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 40rpx;
  background-color: #f5f5f5;
}

.type-tab.active {
  background-color: #007aff;
  color: white;
}

.time-filter {
  display: flex;
  gap: 20rpx;
}

.picker-btn {
  background-color: #f5f5f5;
  padding: 15rpx 25rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

/* 活动列表 */
.activity-list {
  height: calc(100vh - 300rpx);
  padding: 20rpx;
}

.activity-item {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.activity-tags {
  display: flex;
  gap: 15rpx;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.activity-type {
  font-size: 24rpx;
  color: #ff9500;
  background-color: #fff5e8;
  padding: 6rpx 15rpx;
  border-radius: 20rpx;
}

.activity-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.activity-status.upcoming {
  background-color: #e8f4ff;
  color: #007aff;
}

.activity-status.ongoing {
  background-color: #e8ffe8;
  color: #4cd964;
}

.activity-status.completed {
  background-color: #f5f5f5;
  color: #999;
}

.activity-info {
  margin-bottom: 15rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  gap: 30rpx;
  flex-wrap: wrap;
}

.activity-stats {
  display: flex;
  justify-content: flex-start;
  font-size: 24rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}