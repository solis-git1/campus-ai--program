<view class="container">
  <!-- 头部渐变背景 -->
  <view class="header-bg">
    <view class="user-info" bindtap="editProfile">
      <view class="avatar">
        <view class="avatar-placeholder">👤</view>
      </view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="username">学号：{{userInfo.username || '未绑定'}}</text>
      </view>
      <text class="edit-icon">›</text>
    </view>
  </view>


  <view class="brand-card">
    <text class="brand-slogan">华农人的校园助手</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToAccountBind">
      <view class="menu-left">
        <text class="menu-icon">🔗</text>
        <text class="menu-title">账号绑定</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-title">意见反馈</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="shareToFriend">
      <view class="menu-left">
        <text class="menu-icon">📤</text>
        <text class="menu-title">推荐给朋友</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-title">关于校园智能助手</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version">
    <text>版本 v1.0.0</text>
  </view>
</view>