.view-switch {
  display: flex;
  background-color: #f0f0f0;
  border-radius: 48rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #666;
}

.switch-item.active {
  background-color: #4CAF50;
  color: #fff;
}

.week-selector {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.arrow {
  width: 60rpx;
  height: 60rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
}

.week-text {
  font-size: 32rpx;
  font-weight: bold;
}

.week-header, .grid-row {
  display: flex;
}

.time-col {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 16rpx 0;
}

.day-col {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
}

.course-cell {
  flex: 1;
  min-height: 120rpx;
  border: 1rpx solid #eee;
  padding: 8rpx;
}

.course-card {
  background-color: #e8f5e9;
  border-radius: 8rpx;
  padding: 8rpx;
  margin: 4rpx;
}

.course-name {
  font-size: 24rpx;
  font-weight: 500;
  display: block;
}

.course-location, .course-teacher {
  font-size: 20rpx;
  color: #666;
  display: block;
}

.day-header {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.sync-btn {
  color: #4CAF50;
  font-size: 26rpx;
}

.day-course-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.course-time {
  width: 140rpx;
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 500;
}

.course-info {
  flex: 1;
}

.course-info .course-name {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.reminder-btn {
  font-size: 40rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
  z-index: 1000;
}

.modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 34rpx;
  font-weight: bold;
}

.modal-body {
  padding: 30rpx;
}

.info-row {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.modal-footer {
  padding: 20rpx 30rpx 30rpx;
}

.btn-delete {
  background-color: #ff5252;
  color: #fff;
  border-radius: 48rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}