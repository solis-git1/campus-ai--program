.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.filter-section {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item:last-child {
  border-bottom: none;
}

.filter-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  width: 160rpx;
}

.filter-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.date-value {
  color: #007aff;
  font-weight: 500;
}

.filter-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

.search-btn {
  margin-top: 40rpx;
  background-color: #007aff;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx;
}

.classroom-list {
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.classroom-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.classroom-item:last-child {
  border-bottom: none;
}

.classroom-info {
  flex: 1;
}

.classroom-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.classroom-detail {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.classroom-detail text {
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.classroom-action {
  margin-left: 20rpx;
}

.favorite-btn {
  background-color: #007aff;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.favorited-btn {
  background-color: #ff9500;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}